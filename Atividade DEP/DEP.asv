%Pede-se acrescentar ao script da aula de 22/5 o cálculo da DEP através da função de 
% autocorrelação do sinal x(t). Calcular a autocorrelação 
% através do script pela definição de média do produto de x(t) e x(t+tau).
addpath(".");
x=randn(1,512*1024);
N=length(x);
nb=512;
Nb=N/nb;
n=(0:pi/Nb:pi*(1-1/Nb));
hn=ones(1,Nb)-cos(n).^2;
dt=1e-3;
t=0:dt:(Nb-1)*dt;
T=Nb*dt;
df=1/T;
S=zeros(1,Nb);

tau = 2;
%n2=(0:pi/N:pi*(1-1/N));
%hn2=ones(1,N)-cos(n2).^2;
for n=1:nb
    X=1/Nb*fft(hn.*x((n-1)*Nb+1:n*Nb));
    S=S+(abs(X)).^2;
    %S=S+(T*abs(X)).^2;
    Rxx = Auto_correlation(hn.*x((n-1)*Nb+1:n*Nb),dt);
    S_auto_correlation = 1/N*abs(fft(Rxx));
end
S=8/3*S/nb/df;
f=(0:Nb/2-1)*df;
plot(f,S(1:Nb/2));
hold  if (tau>=0)
            x_tau(1:N) = x;
        else
            x_tau(-tau+1:N-tau) = x;
            % tau é <0, Exemplo: tau = -3, x_tau(3:N+3-1)
        endon;
S_auto_correlation = S_auto_correlation*8/3;
plot(f,S_auto_correlation(1:Nb/2));
